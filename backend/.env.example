APP_NAME=Clarijewel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
FRONTEND_URL=http://localhost:3000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=Clarijewel-ec
DB_USERNAME=root
DB_PASSWORD=

# フロントエンド(Next.js)からのCORSを許可するオリジン
SANCTUM_STATEFUL_DOMAINS=localhost:3000
SESSION_DOMAIN=localhost

# Stripe（高額決済を扱うため秘密鍵は必ずサーバー側のみで保持する）
STRIPE_KEY=pk_test_xxxxxxxxxxxxxxxx
STRIPE_SECRET=sk_test_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# 鑑定書PDFの保存先(ローカル or S3)
FILESYSTEM_DISK=local

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# 開発中はメールを実際に送らず storage/logs/laravel.log に書き出す
# （会員登録の確認メールやパスワード再設定のリンクはログから開く）
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
